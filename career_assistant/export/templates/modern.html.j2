{#- Modern: sans with a teal accent, light section rules, tighter header. -#}
{% extends "_base.html.j2" %}
{% block style %}
  body { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; font-size: 10.5pt; color: #2b2b2b; line-height: 1.4; }
  h1 { font-size: 24pt; font-weight: 700; color: #0c7b78; letter-spacing: -0.5px; }
  h2 { font-size: 11.5pt; color: #0c7b78; font-weight: 600; margin: 0 0 4px 0; padding-bottom: 2px; border-bottom: 1px solid #d4ecec; }
  .dates { color: #777; font-size: 9.5pt; }
  .skills p { color: #444; }
{% endblock %}
