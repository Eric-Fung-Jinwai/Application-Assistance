{#- Technical: sans body with a monospace accent on headings/skills, slate accent rules. -#}
{% extends "_base.html.j2" %}
{% block style %}
  body { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 10.5pt; color: #1a1a1a; line-height: 1.4; }
  h1 { font-size: 20pt; font-family: "SFMono-Regular", "Consolas", monospace; }
  h2 { font-size: 11pt; font-family: "SFMono-Regular", "Consolas", monospace; color: #0f4c5c; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px 0; border-bottom: 2px solid #0f4c5c; }
  .skills p { font-family: "SFMono-Regular", "Consolas", monospace; font-size: 9.5pt; }
{% endblock %}
